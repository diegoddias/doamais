# ---------------------------------------------------------------------------
# Doa+ | configuracao do ambiente
# Copie este arquivo para .env e ajuste os valores antes de subir em producao.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Porta em que o sistema fica disponivel na maquina local
PORTA_WEB=8080

# Interface em que a porta acima e publicada. Use 127.0.0.1 quando um proxy
# reverso externo (Traefik, nginx do host) ja atende a internet.
BIND_WEB=0.0.0.0

# ----------------------------------------------------------------- banco ---
POSTGRES_USER=doamais
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=doamais

# ------------------------------------------------------------ seguranca ---
# Chave usada para assinar os tokens de sessao. Gere uma nova com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-producao

# ----------------------------------------------------------- instituicao ---
INSTITUICAO_NOME=QI Escolas e Faculdades Tecnicas - Unidade Alvorada
INSTITUICAO_CIDADE=Alvorada/RS

# Endereco publico do sistema. E o destino do QR Code impresso nos cartazes.
# Local:     http://localhost:8080
# Producao:  https://doamais.diegodias.dev
PUBLIC_BASE_URL=http://localhost:8080

# Dias de antecedencia do alerta de vencimento
DIAS_ALERTA_VALIDADE=30

# ------------------------------------------------- primeiro administrador ---
# Criado automaticamente na primeira execucao. Troque a senha apos entrar.
ADMIN_NOME=Diego Correa Dias
ADMIN_EMAIL=admin@diegodias.dev
ADMIN_SENHA=troque-esta-senha

# ------------------------------------------- HTTPS (perfil "producao") ------
DOMINIO=doamais.diegodias.dev
EMAIL_ACME=admin@diegodias.dev
